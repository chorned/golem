# AGY - Slack Chief of Staff & Hermes Butler Integration
# Configuration Environment Variables

# Slack Socket Mode Credentials
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Default Workspace Configuration
DEFAULT_WORKSPACE_PATH=~/projects/AGY

# Gemini API Key for Front-Door Intent Triage & Dialogue
GEMINI_API_KEY=your_gemini_api_key_here

# Herdr Persistent Session & Socket Settings
HERDR_SESSION=default
HERDR_SOCKET_PATH=~/.config/herdr/herdr.sock
HERDR_BIN=~/.local/bin/herdr

# Fleet Nodes are automatically discovered via `herdr machine list --json`
# Topology Workspaces:
# - fleet-control: Antigravity Chief of Staff
# - homelab-ops: Hermes Butler (Docker, Plex, storage, maintenance)
# - cloud-ops: OCI Cloud Machine
# - dev-grid: Personal Laptop
# - compute-grid: Desktop PC

# BlueBubbles iMessage Transport
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=your_bluebubbles_password
BLUEBUBBLES_WEBHOOK_PORT=8646
BLUEBUBBLES_WEBHOOK_HOST=0.0.0.0
BLUEBUBBLES_ALLOWED_HANDLES=user@example.com,+15551234567

# Sensory Layer Models (Google Gemini API)
MOUTH_MODEL=gemini-3.8-flash
EYES_MODEL=gemini-flash-lite-latest
NOSE_MODEL=gemini-flash-lite-latest

# Backstage Hands Execution Engine & Models
# Supported engines: antigravity | claude_code | opencode
FIRST_MATE_ENGINE=antigravity
GOLEM_DEFAULT_HAND_WORKER=agy
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# Ordered comma-separated models to fail over to when the primary hits quota (empty = disabled)
ANTIGRAVITY_FALLBACK_MODELS=claude-sonnet-5-5-high
CLAUDE_CODE_MODEL=sonnet
OPENCODE_MODEL=deepseek/deepseek-chat

# Real-Time Observability WebUI (Optional Toggle)
# Set to 1 to enable local web dashboard on http://127.0.0.1:8765
GOLEM_ENABLE_WEBUI=0

